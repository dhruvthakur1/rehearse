# Leave MONGODB_URI empty in development to use a throwaway in-memory database.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000

# Frontend origin(s), comma separated.
CLIENT_URL=http://localhost:5173

# Gemini API key from https://aistudio.google.com/apikey. Leave empty to use built-in sample questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
